# Copy to .env.local and fill in what you have. With USE_MOCK_PROVIDERS=true
# the app runs end to end on fake data and none of the provider keys are needed.

# ---- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_MOCK_PROVIDERS=true

# ---- Supabase: database, auth, storage (Step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic Claude: parsing, ranking, research, writing, classification (Step 4+)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-2

# ---- People and email data (Steps 6-7)
APOLLO_API_KEY=
HUNTER_API_KEY=

# ---- Web research: "tavily" or "exa" (Step 7)
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXA_API_KEY=

# ---- Gmail OAuth: send and reply detection (Step 9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key, base64 encoded, used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Inngest: background jobs (Step 10). Not needed for local dev.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Sending limits, enforced on the server (Step 9). Hard maximum is 40.
DAILY_SEND_CAP_DEFAULT=20
DAILY_SEND_CAP_MAX=40
