# Copy to .env.local and fill in what you have. Supabase is required; every
# other service falls back to clearly labelled sample data until its key is set.

# ---- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_MOCK_PROVIDERS=true

# ---- Supabase: database, auth, storage. See docs/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Local development only: sign in without Google. Ignored in production builds.
ENABLE_DEV_LOGIN=false
# Local Postgres for the database tests. Leave empty to skip them.
TEST_DATABASE_URL=

# ---- Anthropic Claude: parsing, ranking, research, writing, classification (Step 4+)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- People and email data (Steps 6-7)
APOLLO_API_KEY=
HUNTER_API_KEY=

# ---- Web research: "tavily" or "exa" (Step 7)
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXA_API_KEY=

# ---- Gmail OAuth: send and reply detection (Step 9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key, base64 encoded, used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Inngest: background jobs (Step 10). Not needed for local dev.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Alternative to Inngest: a secret for /api/cron/run (openssl rand -hex 32).
CRON_SECRET=

# ---- Sending limits, enforced on the server (Step 9). Hard maximum is 40.
DAILY_SEND_CAP_DEFAULT=20
DAILY_SEND_CAP_MAX=40
